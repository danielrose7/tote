# Production values: the publishable key is the web app's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (`vercel env pull`). Google IDs are in
# Google Cloud → Google Auth Platform → Clients (project tote-web-app).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# Optional; defaults to https://tote.tools
EXPO_PUBLIC_APP_URL=https://tote.tools
# The *Web* client (the one configured in Clerk → SSO connections → Google)
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com
# The *iOS* client ("Tote iOS", bundle tools.tote.app); the URL scheme must also
# be in ios-overrides/Tote/Info.plist CFBundleURLSchemes
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps...
