{
  "name": "tote-ios",
  "version": "1.0.1",
  "main": "index.ts",
  "scripts": {
    "ios:sync-overrides": "node ./scripts/sync-ios-overrides.mjs",
    "ios:check-overrides": "node ./scripts/check-ios-overrides.mjs",
    "start": "expo start --dev-client --localhost",
    "start:clear": "expo start --dev-client --localhost --clear",
    "start:lan": "expo start --dev-client --lan",
    "android": "expo run:android",
    "ios": "pnpm ios:sync-overrides && expo run:ios",
    "ios:sim-clean": "pnpm ios:sync-overrides && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 xcodebuild -workspace ios/Tote.xcworkspace -scheme Tote -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 16 Pro' -derivedDataPath ios/build clean build",
    "web": "expo start --web"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "^1.0.2",
    "@bacons/text-decoder": "^0.0.0",
    "@clerk/expo": "^4.6.1",
    "@clerk/expo-google-signin": "^1.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "ably": "^2.22.1",
    "babel-preset-expo": "~58.0.26",
    "dayjs": "^1.11.21",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-auth-session": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-secure-store": "~58.0.3",
    "expo-share-extension": "^5.0.6",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-dnd": "^2.0.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "readable-stream": "^4.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
